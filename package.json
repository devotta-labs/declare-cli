  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "4.1.4",
    "tsx": "^4.19.2",
    "turbo": "^2.5.8",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.0.0"
}
