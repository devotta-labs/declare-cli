{
  "name": "declare-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "turbo run check",
    "plan": "turbo run plan",
    "apply": "turbo run apply",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
